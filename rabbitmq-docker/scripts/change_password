#!/bin/bash
set -e

SECRETS_DIR="${RABBITMQ_POD_SECRETS_DIR:-/etc/secrets/rabbitmq-pod-secrets}"
USERNAME="${1:-}"
PASSWORD="${2:-}"

if [ -z "${USERNAME}" ] && [ -r "${SECRETS_DIR}/RABBITMQ_DEFAULT_USER" ]; then
  USERNAME="$(tr -d '\r\n' < "${SECRETS_DIR}/RABBITMQ_DEFAULT_USER")"
fi

if [ -z "${USERNAME}" ] || [ -z "${PASSWORD}" ]; then
  echo "Usage: change_password <username> <new_password>" >&2
  echo "username and password are required (username may be read from ${SECRETS_DIR}/RABBITMQ_DEFAULT_USER)" >&2
  exit 1
fi

rabbitmqctl change_password "${USERNAME}" "${PASSWORD}"

ENCODED_USER=$(printf %s "${USERNAME}" | base64)
ENCODED_PASSWORD=$(printf %s "${PASSWORD}" | base64)
if [ "${RABBITMQ_ENABLE_IPV6}" == "True" ];
then
  KUBERNETES_SERVICE_HOST_MODIFIED="[$KUBERNETES_SERVICE_HOST]"
else
  KUBERNETES_SERVICE_HOST_MODIFIED=$KUBERNETES_SERVICE_HOST
fi
curl --fail --silent --show-error -k -X PATCH -d @- \
  -H "Authorization: Bearer $(cat /var/run/secrets/kubernetes.io/serviceaccount/token)" \
  -H 'Accept: application/json' \
  -H 'Content-Type: application/json-patch+json' \
  https://"$KUBERNETES_SERVICE_HOST_MODIFIED":"$KUBERNETES_SERVICE_PORT_HTTPS"/api/v1/namespaces/"$MY_POD_NAMESPACE"/secrets/rabbitmq-default-secret <<EOF
   [
      { "op": "replace", "path": "/data/user", "value": "$ENCODED_USER" },
      { "op": "replace", "path": "/data/password", "value": "$ENCODED_PASSWORD" }
   ]
EOF
